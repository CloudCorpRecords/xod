# ==============================================================================
# XOD - The Autonomous Intelligence & Research Agent
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your desired providers:
#   cp .env.example .env
#
# API keys you put here are moved into the macOS Keychain on the next start and removed
# from this file. You can also paste them in Settings inside the app.
#
# NOTE: Xod can run 100% locally with LM Studio or Ollama without any paid keys!
# All external APIs are optional and enhance live research capabilities.
# ==============================================================================

# --- Primary LLM Provider ---
# Options: lm_studio | ollama | fireworks | openai | anthropic | gemini | groq | openrouter
LLM_PROVIDER=lm_studio

# For Local LM Studio (Default OpenAI-compatible local server)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-12b-qat

# For Ollama (Uncomment and set if using Ollama):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# --- Cloud LLM Providers (Optional) ---
# Fireworks AI (High-speed serverless inference)
FIREWORKS_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini, o3-mini)
OPENAI_API_KEY=

# Anthropic (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=

# Google Gemini (Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=

# Groq (Ultra-fast Llama 3 / Mixtral inference)
GROQ_API_KEY=

# OpenRouter (Unified multi-model aggregator)
OPENROUTER_API_KEY=

# --- Search & Intelligence Providers (Optional) ---
# Tavily AI Search (https://tavily.com - Optimized search for AI agents)
TAVILY_API_KEY=

# You.com YDC Index API (https://you.com - High-precision web passages & news)
YOU_API_KEY=

# TrustMRR SaaS Intelligence API (https://trustmrr.com/dashboard-dev - Verified ARR, MRR & Deals)
TRUSTMRR_API_KEY=

# YouTube Data API v3 (Optional: Channel inspection & metadata)
YOUTUBE_API_KEY=

# --- Autonomous Browser Sandbox ---
# Chrome CDP debugging port used for headless/visible browser automation
CHROME_CDP_PORT=9228

# --- Server & Network Settings ---
HOST=127.0.0.1
PORT=8000
CACHE_TTL_SECONDS=300

# --- Contact email sent to public data APIs (SEC EDGAR asks for one) ---
# XOD_CONTACT_EMAIL=you@example.com
