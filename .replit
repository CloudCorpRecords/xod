modules = ["python-3.12", "nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Xod web preview"

[[workflows.workflow]]
name = "Xod web preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "XOD_LIGHTWEIGHT=1 XOD_MUSE_APP_DRY_RUN=1 XOD_NO_UPDATE_CHECK=1 python -m uvicorn app.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
