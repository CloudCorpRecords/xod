#!/usr/bin/env python3
"""
bops: reference host-side wrapper for the browser-ops module.

Runs on the agent host (Tree's VM today; an Xod host tomorrow). It forwards
each browser-ops subcommand to the device over SSH, prints the device's JSON
result, and for screenshot commands also downloads the PNG and adds a
"local_path" field so the calling agent can view the image.

Usage:
  bops status
  bops open --owner <lane> --task <text> --url <url>
  bops register --owner <lane> --task <text> --target <target_id>
  bops heartbeat --owner <lane> [--target <id>]
  bops done --owner <lane> [--target <id>]
  bops list
  bops close-mine --owner <lane>
  bops sweep
  bops shot-tab --target <target_id>
  bops shot-desktop
  bops look --target <id>
  bops click --target <id> (--selector <css> | --text <label> | --index <n>)
  bops type --target <id> (--selector <css> | --text <label>) --value <text> [--clear]
  bops press --target <id> --key <key> [--modifiers ctrl,shift]
  bops scroll --target <id> --delta-x <pixels> --delta-y <pixels>
  bops hover --target <id> (--selector <css> | --text <label> | --index <n>)
  bops drag --target <id> --start-x <n> --start-y <n> --end-x <n> --end-y <n> [--steps <n>]
  bops open-app --app <configured-alias>

Remote connection settings come from the "remote" block of
~/workspace/browser-ops/config.json if present, else config.example.json.
Any host may ignore this wrapper and use its own transport; the contract is
the device-side CLI (src/browser_ops.py) and its JSON in and out.
"""

import json
import base64
import os
import subprocess
import sys

MODULE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOCAL_SHOTS = os.path.join(MODULE_DIR, "screenshots")


def load_remote():
    for name in ("config.json", "config.example.json"):
        path = os.path.join(MODULE_DIR, name)
        if os.path.exists(path):
            with open(path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
            if "remote" in data:
                return data["remote"]
    raise SystemExit("no remote config found in " + MODULE_DIR)


def expand(opt):
    home = os.path.expanduser("~")
    if opt.startswith("~"):
        opt = home + opt[1:]
    return opt.replace("~/", home + "/")


def ssh_base(remote):
    opts = [expand(o) for o in remote.get("ssh_options", [])]
    return opts, remote["ssh_user_host"]


def remote_command(remote, argv):
    """Carry all user arguments as encoded data, not remote shell syntax.

    The bootstrap has no dollar signs, backticks or user-provided quotes and
    works with the documented Python device transport. Native shell proof
    remains separate from a command-construction test.
    """
    executable = remote.get("python", "python")
    if not isinstance(executable, str) or any(c in executable for c in "\"'\r\n$`;|&<>"):
        raise ValueError("remote.python must name one Python executable, not a shell command")
    directory = remote.get("device_dir", "")
    if not isinstance(directory, str) or not directory:
        raise ValueError("remote.device_dir must be configured")
    payload = base64.b64encode(json.dumps({
        "script": directory.rstrip("/\\") + "/browser_ops.py",
        "argv": argv,
    }).encode("utf-8")).decode("ascii")
    bootstrap = ("import base64,json,runpy,sys;"
                 "p=json.loads(base64.b64decode('" + payload + "'));"
                 "sys.argv=[p['script']]+p['argv'];"
                 "runpy.run_path(p['script'],run_name='__main__')")
    return '"' + executable + '" -c "' + bootstrap + '"'


def run_remote(remote, argv):
    opts, host = ssh_base(remote)
    remote_cmd = remote_command(remote, argv)
    proc = subprocess.run(["ssh"] + opts + [host, remote_cmd],
                          capture_output=True, text=True, timeout=120)
    out = proc.stdout.strip()
    if not out:
        return {"ok": False, "error": "Empty response from device.",
                "outcome_unknown": True}, 1
    try:
        result = json.loads(out.splitlines()[-1])
    except json.JSONDecodeError:
        return {"ok": False, "error": "Device did not return JSON.",
                "outcome_unknown": True}, 1
    if not isinstance(result, dict):
        return {"ok": False, "error": "Device returned a non-object response.",
                "outcome_unknown": True}, 1
    if proc.returncode:
        result = {**result, "ok": False, "outcome_unknown": True,
                  "error": result.get("error") or "Remote process failed; inspect before retrying."}
    return result, proc.returncode


def download(remote, device_path):
    opts, host = ssh_base(remote)
    os.makedirs(LOCAL_SHOTS, exist_ok=True)
    base = device_path.replace("\\", "/").rsplit("/", 1)[-1]
    remote_spec = "%s:%s" % (host, device_path.replace("\\", "/"))
    dest = os.path.join(LOCAL_SHOTS, base)
    proc = subprocess.run(["scp"] + opts + [remote_spec, dest],
                          capture_output=True, text=True, timeout=120)
    if proc.returncode != 0:
        return None
    return dest


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    remote = load_remote()
    try:
        result, code = run_remote(remote, argv)
    except subprocess.TimeoutExpired:
        print(json.dumps({"ok": False, "error": "SSH timed out; inspect the device before retrying.",
                          "outcome_unknown": True}))
        return 1
    except (OSError, ValueError) as exc:
        print(json.dumps({"ok": False, "error": "Device transport could not start: " + type(exc).__name__}))
        return 1
    if argv[0] in ("shot-tab", "shot-desktop") and result.get("ok") and result.get("path"):
        local = download(remote, result["path"])
        if local:
            result["local_path"] = local
        else:
            result["download_error"] = "scp of the screenshot failed"
    print(json.dumps(result))
    return 0 if result.get("ok") is True and code == 0 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
