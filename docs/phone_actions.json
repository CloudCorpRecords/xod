{
  "version": 1,
  "description": "Shared contract between Xod (app/services/phone_mcp.py) and the Android phone app. Every phone_action Xod sends is listed here, with the capability the phone must have switched on and whether the action needs the owner's tap on the phone (needs_tap is sent as needs_ok). These are the canonical wire names (the Android PhoneActionContract mirrors them; its older descriptive names are accepted there as aliases only, never sent). The Android app must handle every action listed and no canonical action that is not listed.",
  "actions": [
    {"name": "phone_notify", "capability": "messages", "needs_tap": true},
    {"name": "phone_ask", "capability": "messages", "needs_tap": false},
    {"name": "phone_open_app", "capability": "apps", "needs_tap": false},
    {"name": "phone_screen_read", "capability": "screen", "needs_tap": false},
    {"name": "phone_screen_tap", "capability": "tap", "needs_tap": true},
    {"name": "phone_screen_act", "capability": "tap", "needs_tap": true},
    {"name": "phone_location", "capability": "location", "needs_tap": false},
    {"name": "phone_sms_send", "capability": "sms", "needs_tap": true},
    {"name": "phone_notifications", "capability": "notifications", "needs_tap": false},
    {"name": "phone_calendar", "capability": "calendar", "needs_tap": false},
    {"name": "phone_contacts", "capability": "contacts", "needs_tap": false},
    {"name": "phone_fetch", "capability": "network", "needs_tap": false},
    {"name": "phone_app_run", "capability": "background_apps", "needs_tap": false},
    {"name": "phone_files_list", "capability": "files", "needs_tap": false},
    {"name": "phone_file_read", "capability": "files", "needs_tap": false},
    {"name": "phone_stop", "capability": "", "needs_tap": false}
  ]
}
