{
  "name": "xod-desktop",
  "productName": "Xod",
  "version": "0.4.1",
  "description": "Desktop shell for Xod, a local-first AI research and computer agent.",
  "author": {
    "name": "Xod Contributors",
    "url": "https://github.com/CloudCorpRecords/xod"
  },
  "homepage": "https://github.com/CloudCorpRecords/xod",
  "repository": {
    "type": "git",
    "url": "https://github.com/CloudCorpRecords/xod.git"
  },
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "bundle-python": "node scripts/bundle-python.js",
    "dist": "bash scripts/build-mac.sh",
    "dist:signed": "npm run bundle-python && electron-builder --mac dmg --arm64 -c.mac.hardenedRuntime=true -c.mac.notarize=true",
    "dist:win": "node scripts/bundle-python.js && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.xod.desktop",
    "productName": "Xod",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "backend/app",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.bak"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Xod listens when you talk to it, and for \"Hey Xod\" if you turn that on. Audio is transcribed on this Mac and never uploaded.",
        "NSHumanReadableCopyright": "Copyright © 2026 Xod Contributors. MIT License."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Install Xod",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 110,
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "compression": "normal",
    "copyright": "Copyright © 2026 Xod Contributors. MIT License.",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Xod-${version}-x64-setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xod",
      "runAfterFinish": true
    }
  }
}
